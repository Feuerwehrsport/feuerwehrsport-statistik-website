= count_table(collection.sort_by(&:name)) do |ct|
  - ct.col('Übersicht') { |row|  link_to(row.name, series_path(row.slug)) }
  - ct.col('Jahre') { |row|  safe_join(row.rounds.map { |r| link_to(r.year, r) }, ', ') }
  - ct.col('Disziplinen') { |row|  safe_join(row.disciplines.map { |d| discipline_image_name_short(d) }, ' ') }
