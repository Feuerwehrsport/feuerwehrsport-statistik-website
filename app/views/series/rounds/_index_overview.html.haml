%section.content-card
  = toc.anker(@kind.name, :h2)
  = count_table(@rounds) do |ct|
    - ct.col('Jahr') { |row| link_to(row.year, round_link_prefix + [row], data: { round_id: row.id }) }
    - ct.col('Cup-Anzahl', :cup_count_with_status)
    - ct.col('Disziplinen') { |row| row.disciplines.map { |d| discipline_image_name_short(d) }.join(" ").html_safe }
    - ct.col('Mannschaften', :team_count)
    - ct.col('Wettkämpfer', :person_count)
