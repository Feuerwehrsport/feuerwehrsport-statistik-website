= page_head('Jahre', tiles: [[collection.to_a.size, 'Jahre']])

.container
  .row
    .col-lg-5
      = content_card do
        = count_table(collection, class: 'datatable-years', sort: true) do |t|
          - t.col('Jahr') { |row| year_link(row) }
          - t.col('Wettkämpfe', :count)
    .col-lg-7
      = content_card('Anzahl der Wettkämpfe pro Jahr', heading: :h3) do
        = Chart::YearIndex.new(years: collection).competitions_count
