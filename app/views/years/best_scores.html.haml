= page_head("Bestzeiten #{resource}", breadcrumb: [link_to('Jahre', years_path), link_to(resource, year_path(resource)), 'Bestzeiten']) do
  = render('years/subnav')
  %p.mt-3.mb-0 Die Tabellen zeigen die Bestzeiten des Jahres #{resource} in den einzelnen Disziplinen.

.container
  - best_scores = Calc::YearBestScores.new(year: resource)
  - if best_scores.disciplines.present?
    = content_card do
      = nav_tab do |nv|
        - best_scores.disciplines.each do |struct|
          - nv.tab(discipline_image_name_short(struct[:discipline], struct[:gender])) do
            = count_table(struct[:scores], table_class: Ui::RankTable, class: 'datatable-best-scores', sort: { direction: 'asc' }, rank_options: { class: 'col-w-10' }) do |t|
              - t.col('Name', class: 'col-w-30') { |row| person_link(row.entity, type: :full_name) }
              - t.col('Zeit', :second_time, class: 'col-w-10')
              - t.col('Wettkampf', class: 'col-w-40') { |row| competition_link(row.competition) }
