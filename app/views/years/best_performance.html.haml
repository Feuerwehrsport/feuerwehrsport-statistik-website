= page_head("Bestleistungen #{resource}", breadcrumb: [link_to('Jahre', years_path), link_to(resource, year_path(resource)), 'Bestleistungen']) do
  = render('years/subnav')
  %p.mt-3.mb-0
    Die Tabellen zeigen die Leistungen der besten Sportler und Mannschaften im Jahr #{resource}. Für die Rangordnung
    zählt nicht nur die Durchschnittszeit: Die Strafpunkte steigen mit mehr ungültigen Versuchen und sinken mit mehr
    absolvierten Läufen. So ergibt sich ein Vergleich der konstanten Leistungen.

.container
  - performance_overview_disciplines = Calc::PerformanceOfYear.get(resource.to_i)
  - if performance_overview_disciplines.present?
    = content_card do
      = nav_tab do |nv|
        - performance_overview_disciplines.each do |discipline|
          - nv.tab(discipline_image_name_short(discipline.key, discipline.gender)) do
            = count_table(discipline.entries, class: 'datatable-best-performance', sort: { direction: 'asc' }) do |t|
              - t.col('Rang', :rank, class: 'col-w-10')
              - t.col('Name', class: 'col-w-20 info-link') { |row| person_link(row.entity.decorate, type: :full_name) }
              - t.col('Punkte', :rounded_points, class: 'col-w-10')
              - t.col('Durchschnitt', :second_valid_time_average, class: 'col-w-10')
              - t.col('Zeiten', class: 'col-w-50 small') { |row| score_links(row.scores) }

  = content_card('Berechnung der Strafpunkte', heading: :h3) do
    = design_image(:best_performance, class: 'img-fluid mb-3')
    %p Die abgebildete Formel zeigt die Berechnung für die Strafpunkte. Dabei sind
    %pre.mb-0
      = preserve do
        g = Anzahl gültiger Läufe
        u = Anzahl ungültiger Läufe
        a = g + u
        t = Zeiten der gültigen Läufe
