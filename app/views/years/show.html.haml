= table_of_contents do |toc|
  = page_head("Jahr #{resource}", kicker: 'Überblick', toc:, breadcrumb: [link_to('Jahre', years_path), resource.to_s],
              tiles: [[@competitions.count, 'Wettkämpfe']]) do
    = render('years/subnav')

  .container
    = content_card('Wettkämpfe', toc:) do
      = count_table(@competitions, class: 'datatable-year-competitons', sort: true) do |t|
        - t.col('Datum', class: 'col-w-10 info-link') { |row| competition_link(row, type: :date_iso) }
        - t.col('Ort', class: 'col-w-10 small') { |row| place_link(row.place) }
        - t.col('Typ', class: 'col-w-10 small') { |row| event_link(row.event) }
        - t.col('Name', class: 'col-w-20 info-link') { |row| competition_link(row, type: :name) }
        - t.col('HBw', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.hb_female) }
        - t.col('HBm', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.hb_male) }
        - t.col('HLw', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.hl_female) }
        - t.col('HLm', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.hl_male) }
        - t.col('GS', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.gs) }
        - t.col('FSw', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.fs_female) }
        - t.col('FSm', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.fs_male) }
        - t.col('LAw', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.la_female) }
        - t.col('LAm', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.la_male) }
    = render 'calculation/competitions_discipline_overview', toc:, competitions: @competitions
