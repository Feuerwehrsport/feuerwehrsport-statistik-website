= table_of_contents do |toc|
  - score_type = "Mannschaftswertung: #{resource.score_type.presence || 'keine'}" if @calc.single_score_count > 0
  = page_head(resource.name.presence || resource.to_s, kicker: resource.object.date.strftime('%d.%m.%Y'), toc:,
              breadcrumb: [link_to('Wettkämpfe', competitions_path), resource.to_s],
              chips: [event_link(resource.event), place_link(resource.place), score_type]) do
    = link_to(url_for(format: :xlsx), class: 'btn btn-outline-secondary btn-sm') do
      %span.fa.fa-download{ 'aria-hidden': 'true' }
      Excel-Export

  .container
    - if resource.hint_content.present?
      = content_card('Hinweise', toc:) do
        = rich_text(resource.hint_content)
    - @calc.disciplines.each do |discipline|
      - if Discipline.group?(discipline.discipline)
        = render "group_discipline", toc: toc, discipline: discipline
      - elsif discipline.discipline == :zk
        = render "double_event_discipline", toc: toc, discipline: discipline
      - else
        = render "single_discipline", toc: toc, discipline: discipline, single_discipline: discipline.discipline
      
    - if resource.place.positioned?
      = content_card('Karte', toc:) do
        = map(id: 'competition-map', red: resource.place, markers: resource.teams.select(&:positioned?),
              data: { controller: 'overview-map' })

    .row
      .col-lg-6
        = content_card('Weblinks', toc:) do
          = render('links', links: resource.links, linkable_type: resource_class, linkable_id: resource.id)
      .col-lg-6
        = content_card('Dateien', toc:) do
          - if resource.competition_files.present?
            = render('competition_files', files: resource.competition_files)
          = render('competition_file_form')

    = content_card('Fehler oder Hinweis melden', toc:) do
      .row.g-4
        .col-md-8
          %p
            Beim Importieren der Ergebnisse passieren immer wieder Fehler – zum Beispiel, wenn Namen in den
            Ergebnislisten falsch geschrieben wurden. Du kannst auch Hinweise zum Wettkampf geben, etwa zum Namen,
            zu besonderen Bedingungen, zum Wetter oder zur Aufteilung auf mehrere Orte oder Tage.
          = link_to 'Fehler oder Hinweis melden', new_contributions_competition_change_request_path(resource),
                    id: 'add-change-request', class: 'btn btn-outline-secondary',
                    data: { turbo_frame: 'contribution', turbo: true }
        = render('missed_information', missed: resource.missed_information)
