%table.table
  %tr
    %th Dateien
    %th Enthaltene Ergebnisse
    %th
  - files.each do |file|
    %tr
      %td= link_to(file.file_identifier, file.file.url)
      %td= file.human_keys.join(", ").html_safe
      %td
        = link_to 'Fehler melden', new_contributions_competition_change_request_path(file.competition_id, kind: 'file-error', file_id: file.id),
                  class: 'file-error btn btn-outline-secondary btn-sm', data: { turbo_frame: 'contribution', turbo: true }
