- @page_title = 'Neues Passwort setzen'
= page_head('Neues Passwort setzen', kicker: @login.decorate.to_s)

.container
  .row
    .col-lg-6
      = content_card do
        = simple_form_for @login, as: :password_reset, url: password_reset_path(params[:id]), method: :patch,
                                  wrapper: :vertical_form do |f|
          = f.input :password, label: 'Neues Passwort', required: true, input_html: { autocomplete: 'new-password' }
          = f.input :password_confirmation, label: 'Passwort wiederholen', required: true,
            input_html: { autocomplete: 'new-password' }
          = f.button :submit, 'Passwort speichern', class: 'btn-primary'
