- @page_title = 'E-Mail-Adresse ändern'
= page_head('E-Mail-Adresse ändern')

.container
  .row
    .col-lg-6
      = content_card do
        %dl.show-list
          %dt Bisherige E-Mail-Adresse
          %dd= @login.email_address
          %dt Neue E-Mail-Adresse
          %dd= @login.changed_email_address
        = button_to 'Änderung bestätigen', changed_email_address_path(params[:id]), method: :patch,
                    class: 'btn btn-primary mt-3'
