- @page_title = 'Anmelden'
= page_head('Anmelden', breadcrumb: link_to('Interner Bereich', backend_root_path))

.container
  .row
    .col-lg-6
      = content_card do
        = simple_form_for :session, url: session_path, wrapper: :vertical_form do |f|
          = f.input :email_address, label: 'E-Mail-Adresse', required: true,
            input_html: { value: @email_address, autocomplete: 'username' }
          = f.input :password, label: 'Passwort', required: true, input_html: { autocomplete: 'current-password' }
          .d-flex.flex-wrap.align-items-center.gap-2
            = f.button :submit, 'Anmelden', class: 'btn-primary'
            = link_to 'Passwort vergessen?', new_password_reset_path, class: 'btn btn-link'
    .col-lg-6
      = content_card('Noch kein Konto?') do
        %p
          Mit einem Konto kannst du mehr Funktionen der Feuerwehrsport-Statistik nutzen:
        %ul
          %li
            %strong Import-Anfragen:
            Lade Ergebnislisten hoch, die hier noch fehlen. Du bekommst Bescheid, sobald sie eingetragen sind.
          %li
            %strong Änderungen ohne Rechenaufgabe:
            Fehler melden und Daten ergänzen geht ohne erneute Angabe von Name und E-Mail-Adresse.
        = link_to 'Konto erstellen', new_backend_registration_path, class: 'btn btn-outline-secondary'
