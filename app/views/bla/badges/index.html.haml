= page_head('Bundesleistungsabzeichen', image: image_tag('bla/dfv.png', alt: 'DFV')) do
  %p
    Der Leistungswettbewerb fördert das Leistungsvermögen der Feuerwehrangehörigen – mit sportlichem Ehrgeiz und
    körperlicher Fitness – sowie die kameradschaftlichen Kontakte zwischen den Feuerwehren in Deutschland und den
    Mitgliedsnationen des Internationalen Technischen Komitees für vorbeugenden Brandschutz und Feuerlöschwesen
    (CTIF). Grundlage für den Wettbewerb und damit für den Erwerb des Bundesleistungsabzeichens (BLA) des Deutschen
    Feuerwehrverbandes ist die #{current_wko_link('DFV-Wettkampfordnung')} für Feuerwehrsportwettkämpfe in der
    jeweils gültigen Fassung.

.container
  = content_card('Anforderungen', heading: :h2) do
    .d-flex.gap-2.mb-3
      - %w[bronze silver gold].each do |status|
        = image_tag("bla/badge_#{status}.jpg", height: 64, alt: "Abzeichen #{status}")
    = nav_tab do |t|
      - t.tab 'WKO 2016' do
        %table.table.table-bordered.table-sm
          %tr
            %td
            %th{ colspan: 2 } Frauen
            %th{ colspan: 2 } Männer
          %tr
            %td
            %th= discipline_image_name_short(:hb)
            %th= discipline_image_name_short(:hl)
            %th= discipline_image_name_short(:hb)
            %th= discipline_image_name_short(:hl)
          %tr
            %th Bronze
            %td 21,5 s
            %td 9,5 s
            %td 19,5 s
            %td 18,5 s
          %tr
            %th Silber
            %td 20,5 s
            %td 9,0 s
            %td 18,5 s
            %td 17,0 s
          %tr
            %th Gold
            %td 19,5 s
            %td 8,5 s
            %td 17,5 s
            %td 15,5 s
      - t.tab 'WKO 2012' do
        %p
          Bis zum Jahr 2016 galt die alte Regelung zum Bundesleistungsabzeichen in der #{wko_2012_link('WKO 2012')}.
          Dabei wurden bei elektronischer Zeitnahme 0,3 Sekunden von der erreichten Zeit abgezogen. Daraus ergeben
          sich die zu erreichenden Zeiten in Klammern.
        %table.table.table-bordered.table-sm
          %tr
            %td
            %th{ colspan: 2 } Frauen
            %th{ colspan: 2 } Männer
          %tr
            %td
            %th= discipline_image_name_short(:hb)
            %th= discipline_image_name_short(:hl)
            %th= discipline_image_name_short(:hb)
            %th= discipline_image_name_short(:hl)
          %tr
            %th Bronze
            %td 21,5 s (21,8 s)
            %td
            %td 19,5 s (19,8 s)
            %td 18,5 s (18,8 s)
          %tr
            %th Silber
            %td 20,5 s (20,8 s)
            %td
            %td 18,5 s (18,8 s)
            %td 17,0 s (17,3 s)
          %tr
            %th Gold
            %td 19,5 s (19,8 s)
            %td
            %td 17,5 s (17,8 s)
            %td 15,5 s (15,8 s)

  = content_card('Träger', heading: :h2) do
    %p
      Die folgenden Einträge hat der #{link_to('DFV', 'https://www.feuerwehrverband.de')} geprüft. Du kannst sie
      auch als #{link_to('Excel-Tabelle', format: :xlsx)} herunterladen.
    = count_table(collection, class: 'datatable-bla-badges', sort: { col: 1 }) do |t|
      - t.col('Wettkämpfer') { |row| person_link(row.person) }
      - t.col('Jahr', :year)
      - t.col('Stufe', :status)
