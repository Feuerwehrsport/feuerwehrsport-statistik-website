- @page_title = 'Interner Bereich'
- admin = current_admin_user.try(:role).in?(%i[sub_admin_with_series sub_admin admin])
- actions = capture do
  .btn-group
    = link_to 'Mein Profil', edit_backend_admin_user_path(current_admin_user), class: 'btn btn-outline-secondary'
    = link_to 'Abmelden', session_path, data: { turbo_method: :delete, turbo_confirm: 'Möchtest du dich abmelden?' },
      class: 'btn btn-outline-secondary logout'
= page_head('Interner Bereich', kicker: "Angemeldet als #{current_admin_user&.name}", actions:)

.container
  - if admin
    = render 'admin_dashboard'
  - else
    = render 'user_dashboard'
