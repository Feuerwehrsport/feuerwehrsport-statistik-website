.row
  .col-lg-4
    = content_card('Zu erledigen') do
      %ul.nav-list
        - if can?(:index, ChangeRequest)
          %li= nav_list_link('Fehlermeldungen bearbeiten', backend_change_requests_path, ChangeRequest.open.count)
        - if can?(:index, ImportRequest)
          %li= nav_list_link('Import-Anfragen', backend_import_requests_path, ImportRequest.open.count)
        %li= nav_list_link('Neue Mannschaften prüfen', backend_unchecked_teams_path, Team.unchecked.count)

    = content_card('Werkzeuge') do
      %ul.nav-list
        - if can?(:create, Import::Scores)
          %li= nav_list_link('Ergebnisse importieren', backend_imports_path)
          %li= nav_list_link('Team auseinanderziehen', new_backend_repairs_team_score_move_path)
        - if can?(:create, Series::Round)
          %li= nav_list_link('Serienwettkampf hinzufügen', new_backend_series_round_path)
          %li= nav_list_link('Serienübersicht', backend_series_rounds_path)
          %li= nav_list_link('Serienartenübersicht', backend_series_kinds_path)
        %li= nav_list_link('Cache löschen', new_backend_caching_cleaner_path)
        %li= nav_list_link('Ungenutzte Wettkämpfer löschen', backend_people_cleaner_path)

  .col-lg-8
    = content_card('Daten bearbeiten') do
      %ul.nav-list.nav-list-columns
        - @models.each do |model|
          - if can?(:index, model)
            %li= nav_list_link(model.model_name.human(count: 0), [:backend, model])
