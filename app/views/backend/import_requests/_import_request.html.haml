- editing = resource.edited_at.present? && resource.edit_user == current_admin_user && can?(:create, Import::Scores)
.container
  .row.g-4.mb-4
    .col-lg-6
      = content_card('Bearbeitung', heading: :h3, class: 'h-100') do
        - if resource.edited_at.present?
          %dl.show-list.mb-3
            %dt Name
            %dd= resource.edit_user
            %dt Bearbeitung seit
            %dd= resource.edited_at
            - if resource.finished_at.present?
              %dt Abgearbeitet seit
              %dd= resource.finished_at
          .d-flex.flex-wrap.gap-2
            = button_to 'Bearbeitung abgeben', { action: :update }, method: :patch,
                        params: { 'import_request[edit_user_id]' => '' }, class: 'btn btn-outline-secondary'
            - if resource.finished_at.blank?
              = button_to 'Bearbeitung abschließen', { action: :update }, method: :patch,
                          params: { 'import_request[finished]' => '1' }, class: 'btn btn-outline-secondary'
        - else
          = button_to 'Bearbeitung übernehmen', { action: :update }, method: :patch,
                      params: { 'import_request[edit_user_id]' => current_admin_user.id }, class: 'btn btn-primary'

    .col-lg-6
      = content_card('Import-Anfrage', heading: :h3, class: 'h-100', id: 'import-request-info') do
        - info = resource.competition_info
        - info[:date] = resource.date if resource.date.present?
        %dl.show-list
          - { name: 'Name', date: 'Datum', place: 'Ort', event: 'Typ' }.each do |key, label|
            - if info[key].present?
              %dt= label
              %dd= info[key]
          - if resource.url.present?
            %dt Link
            %dd= resource.url_with_link
          - if resource.admin_user.present?
            %dt Antragsteller
            %dd
              = resource.admin_user
              = mail_to(resource.admin_user.email_address_format, resource.admin_user.email_address,
                        subject: "Import-Anfrage vom #{resource.created_at_date}")
          - if resource.import_request_files.any?
            %dt Dateien
            %dd= resource.import_request_files.size
        - if resource.description.present?
          %h4.fs-6.mt-3 Beschreibung
          .small.text-muted= simple_format resource.description, {}, wrapper_tag: 'div'

- if editing
  = render('backend/imports/import_containers', competition_info: resource.competition_info, import_request: resource,
           selection_url: assign_competition_backend_import_request_path(resource), selection_method: :patch,
           manual_collapsed: resource.import_data.present?) do
    .row.g-4
      - if resource.import_data.present?
        .col-lg-6
          %h3.fs-6 Ergebnisse aus der Anfrage
          .d-flex.flex-wrap.gap-2
            - resource.import_data_results.each_with_index do |result, index|
              - next if result[:discipline] == 'zk'
              - path = ->(gender) { new_backend_imports_discipline_path(discipline: result[:discipline], gender:, competition_id: import_competition.id,
                                                                       import_request_id: resource.id, result_index: index) }
              - label = "#{result[:discipline]} #{result[:rows].count - 1} #{result[:name]}"
              - if result[:gender].in?(%w[female male])
                = link_to "#{result[:discipline]} #{result[:gender]} #{result[:rows].count - 1} #{result[:name]}", path.(result[:gender]),
                          class: "btn btn-outline-primary btn-sm add-discipline discipline-#{result[:discipline]}-#{result[:gender]}",
                          data: { turbo_frame: 'import-discipline', turbo: true }
              - else
                -# feusport sends "indifferent" for assessments without gender: choose it here
                .btn-group.btn-group-sm{ role: 'group', 'aria-label': label }
                  %span.btn.btn-outline-secondary.disabled= label
                  - [%w[female weiblich], %w[male männlich]].each do |gender, name|
                    = link_to name, path.(gender), class: "btn btn-outline-primary add-discipline discipline-#{result[:discipline]}-#{gender}",
                              data: { turbo_frame: 'import-discipline', turbo: true }

      - if resource.import_data_series_rounds.present?
        .col-lg-6#series-add-links
          %h3.fs-6 Serien-Import
          .d-flex.flex-wrap.gap-2
            - resource.import_data_series_rounds.each do |round|
              = link_to(round.name, new_backend_series_round_import_path(round_id: round.id,
                                                                         series_round_import: { import_request_id: resource.id, competition_id: import_competition.id }),
                        class: 'btn btn-outline-secondary btn-sm')

      - if resource.import_request_files.any?
        .col-12
          %h3.fs-6 Dateien
          %table.table.table-sm
            - resource.import_request_files.each do |file|
              %tr
                %td= file.file_with_link
                %td
                  - if file.transfered?
                    = icon(:'arrow-left-right', title: 'übertragen')
                  - elsif file.pdf?
                    = render 'backend/import_request_files/transfer_form', file:
