.container
  .row
    - if resource.admin_user.present?
      .col-md-6
        = content_card('Antragsteller', heading: :h3) do
          %dl.show-list
            %dt Name
            %dd= resource.admin_user
            %dt E-Mail-Adresse
            %dd= resource.admin_user.email_address
            %dt E-Mail-Link
            - subject = "Import-Anfrage vom #{resource.created_at_date}"
            %dd= mail_to(resource.admin_user.email_address_format, nil, subject:)

    .col-md-6
      = content_card('Bearbeitung', heading: :h3) do
        - if resource.edited_at.present?
          %dl.show-list.mb-3
            %dt Name
            %dd= resource.edit_user
            %dt Bearbeitung seit
            %dd= resource.edited_at
            - if resource.finished_at.present?
              %dt Abgearbeitet seit
              %dd= resource.finished_at
          .d-flex.flex-wrap.gap-2
            = button_to 'Bearbeitung abgeben', { action: :update }, method: :patch,
                        params: { 'import_request[edit_user_id]' => '' }, class: 'btn btn-outline-secondary'
            - if resource.finished_at.blank?
              = button_to 'Bearbeitung abschließen', { action: :update }, method: :patch,
                          params: { 'import_request[finished]' => '1' }, class: 'btn btn-outline-secondary'
        - else
          = button_to 'Bearbeitung übernehmen', { action: :update }, method: :patch,
                      params: { 'import_request[edit_user_id]' => current_admin_user.id }, class: 'btn btn-primary'

- if resource.edited_at.present? && resource.edit_user == current_admin_user && can?(:create, Import::Scores)
  = render('backend/imports/import_containers', competition_info: resource.competition_info) do
    - if resource.import_data.present?
      .container
        .row
          .col-md-6
            = content_card('Direkt-Import', heading: :h3) do
              - resource.import_data_results.each_with_index do |result, index|
                - if result[:discipline] != 'zk' && import_competition
                  = link_to new_backend_imports_discipline_path(discipline: result[:discipline], gender: result[:gender],
                                                                competition_id: import_competition.id,
                                                                import_request_id: resource.id, result_index: index),
                            class: "btn btn-outline-secondary btn-sm add-discipline discipline-#{result[:discipline]}-#{result[:gender]}",
                            data: { turbo_frame: 'import-discipline', turbo: true } do
                    #{result[:discipline]} #{result[:gender]} #{result[:rows].count} #{result[:name]}
              - unless import_competition
                %p.text-muted.mb-0 Wähle zuerst einen Wettkampf aus.

          - if resource.import_data_series_rounds.present?
            .col-md-6
              = content_card('Serien-Import', heading: :h3, id: 'series-add-links') do
                - resource.import_data_series_rounds.each do |round|
                  = link_to(round.name, new_backend_series_round_import_path(round_id: round.id,
                                                                             series_round_import: { import_request_id: resource.id, competition_id: import_competition&.id }),
                            class: 'btn btn-outline-secondary btn-sm')

.container
  = content_card('Wettkampf', heading: :h3) do
    %table.table.table-sm
      - resource.import_request_files.each do |file|
        %tr
          %td= file.file_with_link
          %td
            - if file.transfered?
              .fa.fa-exchange-alt{ title: 'übertragen' }
            - elsif file.pdf? && import_competition
              = render 'backend/import_request_files/transfer_form', file:
    %dl.show-list
      - %i[url_with_link date place event].each do |field|
        - if resource.send(field).present?
          %dt= resource_class.human_attribute_name(field)
          %dd= resource.send(field)
      %dt= resource_class.human_attribute_name(:description)
      %dd= simple_format resource.description

  = content_card('Wettkämpfe mit ähnlichem Datum', heading: :h3) do
    = count_table(@nearby_competitions) do |t|
      - t.col('Datum', class: 'col-w-10 info-link') { |row| competition_link(row, type: :date_iso) }
      - t.col('Ort', class: 'col-w-10 small') { |row| place_link(row.place) }
      - t.col('Typ', class: 'col-w-10 small') { |row| event_link(row.event) }
      - t.col('Name', class: 'col-w-20 info-link') { |row| competition_link(row, type: :name) }
      - t.col('HBw', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.hb_female) }
      - t.col('HBm', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.hb_male) }
      - t.col('HLw', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.hl_female) }
      - t.col('HLm', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.hl_male) }
      - t.col('GS', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.gs) }
      - t.col('FSw', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.fs_female) }
      - t.col('FSm', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.fs_male) }
      - t.col('LAw', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.la_female) }
      - t.col('LAm', th_options: { class: 'small' }, class: 'col-w-5') { |row| count_or_zero(row.la_male) }
