- source = resource.source_team
- destination = resource.destination_team
- groups = { 'Löschangriff' => source.group_scores.discipline(:la), 'Feuerwehrstafette' => source.group_scores.discipline(:fs),
            'Gruppenstafette' => source.group_scores.discipline(:gs), 'Einzeldisziplin' => source.scores }
= render 'hero', actions: false
.section
  .container
    %p
      Von: #{source} (ID #{source.id}, #{source.decorate.full_state})
      %br
      Nach: #{destination} (ID #{destination.id}, #{destination.decorate.full_state})
    %p Markiere die Zeiten, die zu #{destination} gehören. Ein Klick auf die Zeile markiert sie.
  .container
    = form_with url: execute_backend_repairs_team_score_move_path, id: 'team-score-move-form' do
      = hidden_field_tag :source_team_id, source.id
      = hidden_field_tag :destination_team_id, destination.id
      %table#score-table.table.table-hover.table-condensed.table-bordered
        - groups.each do |title, scores|
          - next if scores.empty?
          %tr
            %th.text-center{ colspan: 5 }= title
          %tr
            %th Verschieben
            %th ID
            %th N
            %th Wettkampf
            %th Zeit
          - scores.decorate.each do |score|
            - field = score.object.is_a?(Score) ? 'score_ids[]' : 'group_score_ids[]'
            - id = "move-#{field.delete('[]')}-#{score.id}"
            %tr
              %td= check_box_tag field, score.id, false, id:
              %td= label_tag id, score.id
              %td= label_tag id, score.team_number
              %td= link_to score.competition.to_s, competition_path(score.competition)
              %td= label_tag id, score.second_time
      = submit_tag 'Ausgewählte Zeiten verschieben', class: 'btn btn-primary',
                   data: { confirm: "Die markierten Zeiten wirklich von #{source} nach #{destination} verschieben?" }
      = link_to('Zurück', url_for(action: :new, Repairs::TeamScoreMove.model_name.param_key => { source_team_id: source.id, destination_team_id: destination.id }), class: 'btn btn-default')
