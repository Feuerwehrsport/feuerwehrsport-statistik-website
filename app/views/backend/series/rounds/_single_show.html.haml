= render 'series/rounds/show', toc: toc, cache: false, round: round

- @person_assessments.each do |assessment|
  %hr
  .pull-right
    - round.cups.each do |cup|
      = link_to "Eintrag zu #{cup} hinzufügen",
                new_backend_series_person_participation_path(cup_id: cup.id, person_assessment_id: assessment.id),
                class: 'btn btn-info btn-sm'

  = toc.anker(assessment.to_s, :h3)
  = render 'series/person_assessments/show_assessment_table', rows: assessment.rows, cups: assessment.cups, round: round
