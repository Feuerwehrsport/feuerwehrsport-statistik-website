.container
  = content_card do
    .d-flex.flex-wrap.gap-2
      = link_to("Live-Ansicht: #{resource}", team_path(resource), class: 'btn btn-outline-secondary btn-sm', target: :_blank)
      = link_to("Backend: #{resource}", backend_team_path(resource), class: 'btn btn-outline-secondary btn-sm', target: :_blank)
  - if resource.similar_teams.present?
    = content_card('Ähnlich geschriebene Mannschaften', heading: :h3) do
      %table.table
        - resource.similar_teams.decorate.each do |team|
          %tr
            %td= team_link(team, target: :_blank)
            %td
              - path = merge_backend_unchecked_team_path(resource)
              - confirm = "#{resource.name} wirklich mit #{team.name} zusammenführen? Diese Aktion verändert die Daten!"
              = button_to 'Zusammenführen', path, params: { correct_team_id: team.id },
                          class: 'btn btn-outline-secondary btn-sm', form_class: 'inline-form', data: { turbo_confirm: confirm }
              = button_to 'Immer zusammenführen', path, params: { correct_team_id: team.id, always: 1 },
                          class: 'btn btn-outline-secondary btn-sm', form_class: 'inline-form',
                          data: { turbo_confirm: "#{confirm} Beim Import wird in Zukunft immer automatisch der Name ersetzt." }
  -# results are loaded in the browser (stimulus lookup), wikipedia and nominatim allow cross-origin requests
  = content_card('Infos auf Wikipedia', heading: :h3,
                 data: { controller: 'lookup', lookup_service_value: 'wikipedia', lookup_query_value: resource.shortcut }) do
    %table.table
      %tbody{ data: { lookup_target: 'results' } }
        %tr
          %td Suche läuft …
  = content_card('Land/Bundesland', heading: :h3) do
    = resource.full_state
    = link_to edit_contributions_team_state_path(resource), id: 'edit-state', title: 'Bundesland bearbeiten',
              'aria-label': 'Bundesland bearbeiten', class: 'btn btn-sm btn-outline-secondary',
              data: { turbo_frame: 'contribution', turbo: true } do
      %span.fa.fa-pen{ 'aria-hidden': 'true' }

  - unless resource.positioned?
    = content_card('Geo-Position suchen', heading: :h3,
                   data: { controller: 'geo-position', geo_position_url_value: edit_contributions_team_geo_position_path(resource),
                           action: 'geo-position:move@window->geo-position#move' }) do
      %div{ data: { controller: 'lookup', lookup_service_value: 'nominatim', lookup_query_value: resource.shortcut } }
        %table.table
          %tbody{ data: { lookup_target: 'results' } }
            %tr
              %td Suche läuft …
      = map(id: 'team-map', red: resource, data: { team_id: resource.id, geo_position_target: 'map' })
      .team-map-actions
        %div{ hidden: true, data: { geo_position_target: 'save' } }
          %p Verschiebe den roten Marker an die richtige Stelle.
          %button.btn.btn-primary{ type: 'button', data: { action: 'geo-position#save' } } Speichern
  = content_card('Abgearbeitet', heading: :h3) do
    = button_to('Fertigstellen', {}, params: { 'unchecked_team[checked_at]' => Time.current }, method: :put,
                class: 'btn btn-primary', data: { turbo_confirm: 'Mannschaft als geprüft markieren?' })
