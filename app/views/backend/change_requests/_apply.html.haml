-# button "Beheben": changes the data and closes the change request
- confirm = "Diese Aktion verändert die Daten! #{local_assigns[:hint]} Fehler wirklich beheben?".squish
= button_to local_assigns[:label] || 'Beheben', apply_backend_change_request_path(change_request),
            params: local_assigns[:params] || {}, class: "btn #{local_assigns[:class] || 'btn-success'}",
            data: { turbo_confirm: confirm }
