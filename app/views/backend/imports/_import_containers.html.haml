-# competition selection and import of results (backend imports and import requests)
- competition_info ||= nil
- competition = import_competition
.container
  = content_card('Wettkampf') do
    .row
      .col-md-5
        = form_with url: request.path, method: :get, data: { controller: 'auto-submit' } do
          .form-check.form-check-inline
            %label.form-check-label
              = radio_button_tag :order, 'latest', params[:order] != 'sorted', data: { action: 'auto-submit#submit' }, class: 'form-check-input'
              Zuletzt angelegt
          .form-check.form-check-inline
            %label.form-check-label
              = radio_button_tag :order, 'sorted', params[:order] == 'sorted', data: { action: 'auto-submit#submit' }, class: 'form-check-input'
              Nach Datum
          = label_tag :competitions, 'Wettkampf', class: 'visually-hidden'
          .input-group
            = select_tag :competition_id,
                         options_for_select([['Bitte wählen', '']] + import_competitions.map { ["#{it.date} - #{it.event} - #{it.place}", it.id] },
                                            competition&.id),
                         id: 'competitions', class: 'form-select',
                         data: { action: 'auto-submit#submit' }
            %button.btn.btn-outline-secondary{ type: 'submit' } Auswählen
        - if competition
          %p
            = link_to competition.to_s, competition_path(competition), id: 'competition-link'
            %br
            = link_to "#{competition} - Admin", backend_competition_path(competition), id: 'competition-link-admin'
          = form_with url: score_type_backend_imports_path(competition_id: competition.id), method: :patch, class: 'd-flex flex-wrap gap-2 align-items-center' do
            = label_tag :score_type_id, 'Mannschaftswertung'
            = select_tag :score_type_id,
                         options_for_select([['--', '']] + ScoreType.all.map { ["#{it.score}/#{it.run}/#{it.people}", it.id] },
                                            competition.score_type_id),
                         class: 'form-control form-control-sm'
            %button.btn.btn-outline-secondary.btn-sm{ type: 'submit' } Speichern
      .col-md-2
        - if competition
          %table#competition-scores.table.table-sm
            - ExtendedCompetitionSerializer.new(competition.object).score_count.each do |discipline, genders|
              - genders.each do |gender, count|
                - next unless count.positive?
                %tr
                  %th= "#{discipline}-#{gender}"
                  %td= count
      .col-md-5
        - info = (competition_info || {}).slice(:name, :date, :place, :event)
        - suggestions = import_competition_suggestions(info[:date]).reject { it.id == competition&.id }
        - if suggestions.any?
          %p.mb-1 Wettkämpfe am selben Datum:
          #competition-suggestions.d-flex.flex-wrap.gap-2.mb-3
            - suggestions.each do |suggestion|
              = link_to "#{suggestion.date} - #{suggestion.event} - #{suggestion.place}",
                        "#{request.path}?competition_id=#{suggestion.id}", class: 'btn btn-outline-primary btn-sm'
        %p
          = link_to 'Wettkampf anlegen', new_backend_imports_competition_path(info.merge(return_to: request.path)),
                    class: 'btn btn-outline-secondary btn-sm', data: { turbo_frame: 'import-competition', turbo: true }
          = link_to 'Gruppen-Typ anlegen', new_backend_group_score_type_path, class: 'btn btn-outline-secondary btn-sm', target: :_blank
        %details
          %summary Gruppen-Typen
          %table.table.table-sm
            - GroupScoreType.reorder(:discipline, :name).each do |type|
              %tr
                %td= type.discipline
                %td= type.name
    = turbo_frame_tag 'import-competition', data: { turbo: true }
- if block_given?
  = yield
- if competition
  .container
    = content_card('Disziplin importieren') do
      .row
        - [%w[la Löschangriff], %w[hb Hindernisbahn], %w[fs Feuerwehrstafette], %w[hl Hakenleitersteigen],
           %w[gs Gruppenstafette]].each do |discipline, name|
          .col-md-2
            %h4= name
            - (discipline == 'gs' ? %w[female] : %w[male female]).each do |gender|
              = link_to gender, new_backend_imports_discipline_path(discipline:, gender:, competition_id: competition.id),
                        class: "btn btn-outline-secondary btn-sm add-discipline discipline-#{discipline}-#{gender}",
                        data: { turbo_frame: 'import-discipline', turbo: true }
      = turbo_frame_tag 'import-discipline', data: { turbo: true }
- else
  .container
    = content_card do
      %p.text-muted.mb-0 Wähle zuerst einen Wettkampf aus.
