.association-select-wrapper{ data: { controller: 'association-select',
                                     association_select_url_value: association_select_url(association, filter:, rtp: nil) } }
  = input

  %ul.as-ul
    %li
      .as-remove &#10005;
      .as-info &ndash;
      .as-label &ndash;
      - if show_input_description
        .as-desc &ndash;

  %a.as-add.btn.btn-outline-secondary{ href: "##{id_prefix}-modal" }
    - if multi_select
      = t('.add')
    - else
      = t('.select')
  - if remove_all
    %div.as-remove-all
      .as-remove-all-label= t('.remove_all')
      .as-remove-all-icon &#10005;

  .modal.fade{ id: "#{id_prefix}-modal" }
    .modal-dialog.modal-lg
      .modal-content
        .modal-header
          %button.btn-close.modal-close{ type: :button, 'data-bs-dismiss': :modal, 'aria-label': 'Schließen' }
          %div &nbsp;
          .as-search-wrapper
            %div
              %input.form-control.as-search{ type: :text, placeholder: t('.search') }
            %div
              %span.is-loading-icon.spinner-border.spinner-border-sm{ role: 'status', 'aria-label': 'Lädt …' }
        .modal-body
          %ul.as-ul
            %li.as-selectable
              .as-info &ndash;
              .as-label &ndash;
              .as-desc &ndash;
        .modal-footer.as-groups
          %button.as-group.btn.btn-outline-secondary.btn-sm{ type: :button } Group