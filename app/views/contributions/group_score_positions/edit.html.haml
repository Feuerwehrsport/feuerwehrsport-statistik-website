- discipline = @group_score.discipline
- position_name = competitor_position(discipline, @position, @group_score.gender)
- overview = edit_contributions_group_score_participations_path(@group_score)
- path = contributions_group_score_position_path(@group_score, @position)
= render layout: 'contributions/shared/dialog', locals: { title: "#{position_name} im Lauf #{@group_score.decorate.second_time}" } do
  %p
    Aktuell:
    %strong= @current_person ? "#{@current_person.full_name} (#{@current_person.gender_translated})" : 'niemand'

  = form_with url: edit_contributions_group_score_position_path(@group_score, @position), method: :get do
    = label_tag :q, 'Person suchen', class: 'visually-hidden'
    .input-group
      = search_field_tag :q, params[:q], class: 'form-control', placeholder: 'Name suchen', autofocus: true
      %button.btn.btn-outline-secondary{ type: 'submit' } Suchen
    - if @group_score.gender.to_s == 'male'
      .form-check
        %label.form-check-label
          = check_box_tag :include_women, '1', @include_women, class: 'form-check-input'
          Auch Frauen anzeigen

  %table.table.table-sm.table-hover.select-person
    - @people.each do |person|
      %tr
        %td= person.last_name
        %td= person.first_name
        %td.small= person.object.teams.pluck(:name).join(', ')
        %td.text-end
          = button_to 'Auswählen', path, method: :patch, params: { person_id: person.id },
                                         class: 'btn btn-sm btn-primary', disabled: person.id == @current_person&.id
    - if @people.empty?
      %tr
        %td.text-muted Keine passende Person gefunden.

  .contribution-dialog-actions
    = link_to 'Neue Person anlegen', new_contributions_person_path(group_score_id: @group_score.id, position: @position),
              class: 'btn btn-outline-secondary btn-sm'
    - if @current_person
      = button_to 'Person entfernen', path, method: :patch, params: { person_id: '' }, form_class: 'inline-form',
                                           class: 'btn btn-outline-secondary btn-sm'
    = link_to 'Zurück', overview, class: 'btn btn-outline-secondary btn-sm'
