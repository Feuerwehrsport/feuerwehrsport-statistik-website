= render layout: 'contributions/shared/dialog', locals: { title: "Fehler melden: #{@person}" } do
  - if @error.present?
    .alert.alert-danger= @error
  - path = ->(kind) { new_contributions_person_change_request_path(@person, kind:) }

  - case @kind
  - when nil
    %p Was ist falsch?
    .list-group
      = link_to 'Person ist falsch geschrieben', path.('wrong'), class: 'list-group-item'
      = link_to 'Person ist falscher Nation zugeordnet', path.('change-nation'), class: 'list-group-item'
      = link_to 'Etwas anderes', path.('other'), class: 'list-group-item'
    = render 'contributions/shared/actions'

  - when 'wrong'
    %p Wie soll der Fehler korrigiert werden?
    .list-group
      = link_to path.('merge'), class: 'list-group-item' do
        Richtige Schreibweise auswählen
        %small.text-muted (für die Administratoren viel einfacher)
      = link_to 'Selbst korrekte Schreibweise angeben', path.('correction'), class: 'list-group-item'
    = render 'contributions/shared/actions', cancel: 'Abbrechen'

  - when 'correction'
    = form_with url: contributions_person_change_request_path(@person) do
      = hidden_field_tag :kind, @kind
      %p Bitte korrigieren Sie den Namen:
      = render 'contributions/shared/text_field', name: :first_name, label: 'Vorname',
                                                 value: params[:first_name] || @person.first_name
      = render 'contributions/shared/text_field', name: :last_name, label: 'Nachname',
                                                 value: params[:last_name] || @person.last_name
      = render 'contributions/shared/actions', submit: 'Fehler melden'

  - when 'merge'
    %p Suchen Sie die Person mit der richtigen Schreibweise:
    = form_with url: new_contributions_person_change_request_path(@person), method: :get do
      = hidden_field_tag :kind, @kind
      = label_tag :q, 'Name suchen', class: 'visually-hidden'
      .input-group
        = search_field_tag :q, params[:q], class: 'form-control', placeholder: 'Name', autofocus: true
        %button.btn.btn-outline-secondary{ type: 'submit' } Suchen
    - if params[:q].present?
      = form_with url: contributions_person_change_request_path(@person) do
        = hidden_field_tag :kind, @kind
        = hidden_field_tag :q, params[:q]
        - if @people.any?
          .contribution-dialog-choices
            - @people.each do |person|
              .form-check
                %label.form-check-label
                  = radio_button_tag :correct_person_id, person.id, params[:correct_person_id].to_s == person.id.to_s, class: 'form-check-input'
                  #{person.last_name}, #{person.first_name} (#{person.gender_translated})
          = render 'contributions/shared/actions', submit: 'Fehler melden'
        - else
          %p.text-muted Keine passende Person gefunden.
          = render 'contributions/shared/actions'
    - else
      = render 'contributions/shared/actions'

  - when 'change-nation'
    = form_with url: contributions_person_change_request_path(@person) do
      = hidden_field_tag :kind, @kind
      .row.mb-3
        = label_tag :nation_id, 'Nation', class: 'col-form-label col-sm-3'
        .col-sm-9
          = select_tag :nation_id, options_for_select(Nation.order(:name).pluck(:name, :id),
                                                      params[:nation_id] || @person.nation_id), class: 'form-select'
      = render 'contributions/shared/actions', submit: 'Fehler melden'

  - when 'other'
    = form_with url: contributions_person_change_request_path(@person) do
      = hidden_field_tag :kind, @kind
      .mb-3
        = label_tag :description, 'Bitte beschreiben Sie das Problem:'
        = text_area_tag :description, params[:description], class: 'form-control', rows: 5
      = render 'contributions/shared/actions', submit: 'Fehler melden'
