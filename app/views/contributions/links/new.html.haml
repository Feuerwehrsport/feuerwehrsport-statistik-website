= render layout: 'contributions/shared/dialog', locals: { title: "Link hinzufügen: #{@linkable.decorate}" } do
  - if @error.present?
    .alert.alert-danger= @error
  = simple_form_for @link, url: contributions_links_path do |f|
    = hidden_field_tag :linkable_type, @linkable.class.name
    = hidden_field_tag :linkable_id, @linkable.id
    = f.input :label, label: 'Name', hint: 'Zum Beispiel „Website der Feuerwehr“ oder „Ergebnisse“'
    = f.input :url, label: 'Link', input_html: { placeholder: 'https://' }
    = render 'contributions/shared/actions', submit: 'Hinzufügen'
