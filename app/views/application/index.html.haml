= render 'hero', actions: collection_actions

= render layout: 'index_table_section' do
  = render layout: 'index_table' do |res, index|
    = render layout: 'index_table_row', locals: { res: res } do
      - actions = member_actions(res)
      - if actions.size > index_table_max_actions
        .btn-group
          - actions.first(index_table_max_actions).each do |action|
            = action.link_to class: 'btn btn-outline-secondary btn-sm'
          %button.btn.btn-outline-secondary.btn-sm.dropdown-toggle.dropdown-toggle-split{ type: :button, data: { bs_toggle: :dropdown }, aria: { haspopup: true, expanded: false, label: 'Weitere Aktionen' } }
          %ul.dropdown-menu
            - actions.drop(index_table_max_actions).each do |action|
              %li= action.link_to
      - else
        - actions.each do |action|
          = action.link_to class: 'btn btn-outline-secondary btn-sm'
