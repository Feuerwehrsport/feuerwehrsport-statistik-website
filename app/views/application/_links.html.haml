- links.each do |link|
  %h4{ data: { link_id: link.id } }
    %a{ href: link.url }
      %span.glyphicon.glyphicon-hand-right
      = link.label
    &nbsp;
    %small
      = link_to new_contributions_link_report_path(link), class: 'report-link btn btn-default btn-xs',
                title: "Link »#{link.label}« melden", data: { turbo_frame: 'contribution', turbo: true } do
        %span.glyphicon.glyphicon-flag

= link_to 'Link hinzufügen', new_contributions_link_path(linkable_type:, linkable_id:), class: 'add-link btn btn-default',
                                                                                   data: { turbo_frame: 'contribution', turbo: true }
