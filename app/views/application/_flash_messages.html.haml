- mappings = { 'alert' => 'danger', 'notice' => 'info' }
- flash.each do |name, msg|
  - type = mappings[name] || name
  .container.mt-3
    .alert.alert-dismissible{ class: "alert-#{type}", role: 'alert' }
      != msg
      %button.btn-close{ type: 'button', data: { bs_dismiss: 'alert' }, 'aria-label': 'Schließen' }
