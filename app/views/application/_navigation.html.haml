-# main navigation; static content (the page may come from the HTML cache), so no login dependent parts
- nav_link = ->(label, path, active) { link_to(label, path, class: "nav-link#{' active' if active}", 'aria-current': (active ? 'page' : nil)) }
- section = controller_path.split('/').first
%header.site-header
  %nav.navbar.navbar-expand-lg.navbar-dark{ 'aria-label': 'Hauptnavigation' }
    .container
      = link_to root_path(rtp: nil), class: 'navbar-brand' do
        = logo_mark(34)
        %span
          Feuerwehrsport
          %span.brand-light Statistik
      %button.navbar-toggler{ type: 'button', data: { bs_toggle: 'collapse', bs_target: '#main-navigation' },
                              aria: { controls: 'main-navigation', expanded: 'false', label: 'Navigation umschalten' } }
        %span.navbar-toggler-icon
      #main-navigation.collapse.navbar-collapse
        %ul.navbar-nav.me-auto
          %li.nav-item= nav_link.('Wettkämpfe', competitions_path, section == 'competitions')
          %li.nav-item= nav_link.('Serien', series_kinds_path, section == 'series')
          %li.nav-item= nav_link.('Mannschaften', teams_path, section == 'teams')
          %li.nav-item= nav_link.('Personen', people_path, section == 'people')
          %li.nav-item.dropdown
            %a.nav-link.dropdown-toggle{ href: '#', role: 'button', data: { bs_toggle: 'dropdown' }, aria: { expanded: 'false' } }
              Statistiken
            %ul.dropdown-menu
              %li= link_to('Feuerwehrsport', feuerwehrsport_path, class: 'dropdown-item')
              %li= link_to('Orte', places_path, class: 'dropdown-item')
              %li= link_to('Typen', events_path, class: 'dropdown-item')
              %li= link_to('Jahre', years_path, class: 'dropdown-item')
              %li
                %hr.dropdown-divider
              %li
                %h6.dropdown-header Interessantes
              %li= link_to('Rekorde', records_path, class: 'dropdown-item')
              %li= link_to('100 Bestzeiten', best_of_path, class: 'dropdown-item')
              %li= link_to('Bundesleistungsabzeichen', bla_badges_path, class: 'dropdown-item')
              - year = Date.current.year
              - 4.times do |i|
                %li= link_to("Statistiken #{year - i}", year_path(id: year - i), class: 'dropdown-item')
              %li= link_to('Letzte Änderungen', change_logs_path, class: 'dropdown-item')
              %li= link_to('Über', about_path, class: 'dropdown-item')
        %ul.navbar-nav
          -# backend pages are never cached, so they may show the login state
          - label = section == 'backend' && current_login ? 'Interner Bereich' : 'Anmelden'
          %li.nav-item= nav_link.(label, backend_root_path, section == 'backend')
