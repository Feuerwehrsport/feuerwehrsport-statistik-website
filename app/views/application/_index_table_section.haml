.container
  = content_card(class: "index-table-section") do
    = render 'filter_form', filters: filter_structure, collection: collection
    - if collection.blank?
      %p.text-muted.mb-0= ca_t(:empty_collection)
    - else
      = yield
      .index-table-footer
        = render 'index_pagination'
        = export_format_list
