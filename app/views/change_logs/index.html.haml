= page_head('Veränderungen')

.container
  = content_card do
    = count_table(collection, class: 'datatable-change-logs') do |t|
      - t.col('Zeitpunkt', :created_at, class: 'col-w-15')
      - t.col('Beschreibung', :translated_action, class: 'col-w-15')
      - t.col('Inhalt', :readable_content, class: 'col-w-70')
