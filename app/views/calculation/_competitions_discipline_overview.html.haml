- chart = Chart::CompetitionsScoreOverview.new(competitions:)
%section.content-card
  = toc.anker 'Auswertung', :h2
  .row
    .col-md-4
      %h3.h6 Verteilung der Wettkämpfe über das Jahr
      = chart.year_overview
    .col-md-4
      %h3.h6 Verteilung der Wettkämpfe über die Woche
      = chart.week_overview
    .col-md-4
      %h3.h6 Angebotene Disziplinen pro Wettkampf
      = chart.disciplines_overview
    .col-md-4
      %h3.h6 Mannschaftswertungen der Einzeldisziplinen
      = chart.team_scores_overview
    .col-md-4
      %h3.h6 Anzahl der Mannschaften pro Wettkampf
      = chart.teams_count_overview
    .col-md-4
      %h3.h6 Anzahl der Einzelstarter pro Wettkampf
      = chart.people_count_overview

%section.content-card
  = toc.anker 'Bestenliste', :h2
  = nav_tab do |t|
    - Calc::CompetitionsScoreOverview.new(competitions:).disciplines.each do |key, genders|
      - genders.each do |gender, overview|
        - t.tab(discipline_image_name_short(key, gender)) do
          - overview.types.each do |key, type|
            .row
              .col-md-6
                - if type.type.present?
                  %h4= type.type
                %table.table
                  %tr
                    %th Durchschnitt
                    %td= "#{Firesport::Time.second_time(type.average)} s"
                  %tr
                    %th Anzahl
                    %td= type.count
                  - if type.best.present?
                    %tr
                      %th Bestzeit
                      %td
                        = "#{type.best.second_time} s"
                        %br
                        = link_to(type.best.competition, type.best.competition)
              .col-md-6
                %table.table
                  - type.years.each do |year, bests|
                    - bests.each do |best|
                      %tr
                        %th= year
                        %td= "#{best.second_time} s"
                        %td
                          = link_to(best.entity.full_name, best.entity)
                          %br
                          = link_to(best.competition, best.competition)
