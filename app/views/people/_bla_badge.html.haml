%section.content-card
  %h3 Bundesleistungsabzeichen
  .row.g-3
    .col-3
      = image_tag("bla/badge_#{badge.object.status}.jpg", class: 'img-fluid', alt: "Abzeichen #{badge.status}")
    .col-9
      %p
        Träger in der Stufe <strong>#{badge.status}</strong> –
        %em eine offizielle Auszeichnung des Deutschen Feuerwehrverbandes.
      %table.table.table-sm
        %tr
          %th Verliehen
          %td= badge.year
        - [:hl, :hb].each do |discipline|
          - if badge.send("#{discipline}_time").present?
            %tr
              %th= discipline_name(discipline)
              %td
                = "#{badge.send("second_#{discipline}_time")} s"
                - if badge.send("#{discipline}_score")
                  %span.small.text-body-secondary
                    = competition_link(badge.send("#{discipline}_score").competition)
      = link_to('Details zum Bundesleistungsabzeichen', bla_badges_path)
