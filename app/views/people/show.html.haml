= table_of_contents do |toc|
  - chart = Chart::PersonShow.new(person: resource, team_structs: @team_structs)
  - nation = capture do
    = resource.nation.nation_flag
    = resource.nation
  - spellings = capture do
    - if @person_spellings.any?
      %span{ title: 'Zum Beispiel nach einer Hochzeit' }
        auch bekannt als #{@person_spellings.map(&:full_name).join(', ')}
  - title = capture do
    = resource.full_name
    %span{ class: "gender-#{resource.gender}" }= g_symbol(resource.gender)
  = page_head(title, breadcrumb: [link_to('Personen', people_path), resource.full_name], toc:,
              chips: [nation, *@teams.first(4).map { |team| link_to(team.shortcut.presence || team.name, team) },
                (link_to("+ #{@teams.count - 4} weitere", '#toc-mannschaften') if @teams.count > 4), spellings],
              tiles: [[@score_count, 'Zeiten'], [@competition_count, 'Wettkämpfe'], [@teams.count, 'Mannschaften']])

  .container
    - year_chart = chart.year_overview
    - if year_chart.present? || resource.bla_badge
      .row
        - if year_chart.present?
          .col-lg-5
            = content_card('Ø Zeiten pro Jahr', heading: :h3) do
              = year_chart
        - if resource.bla_badge
          .col-lg-7= render('bla_badge', badge: resource.bla_badge)
    - People::SingleDisciplineOverview.for(resource).each do |discipline_struct|
      = render('person_single_discipline_overview', toc:, chart:, ds: discipline_struct)
    - People::DoubleEventDisciplineOverview.for(resource).each do |discipline_struct|
      = render('person_double_event_discipline_overview', toc:, chart:, ds: discipline_struct)
    - People::GroupDisciplineOverview.for(resource).each do |discipline_struct|
      = render('person_group_discipline_overview', toc:, chart:, ds: discipline_struct)


    - if @teams.present?
      = content_card('Mannschaften', toc:) do
        - @team_structs.each do |team_struct|
          = render('person_team_overview', team_struct:, chart:)

    - if @series_structs.present?
      = render('series', toc:)

    = render 'ui/report_error', toc:, label: 'Fehler mit dieser Person melden',
                                url: new_contributions_person_change_request_path(resource)
