= table_of_contents do |toc|
  - chart = Chart::PersonIndex.new
  = page_head('Wettkämpfer', toc:, tiles: [[Person.female.count, 'Frauen'], [Person.male.count, 'Männer']])

  .container
    - [:female, :male].each do |gender|
      = content_card(gender == :female ? 'Frauen' : 'Männer', toc:) do
        = datatable(:"people_#{gender}")

    = content_card('Auswertung', toc:) do
      .row
        .col-md-4
          %h3.h6 Geschlechter
          = chart.gender_pie
        .col-md-4
          %h3.h6 Disziplinen bei Frauen
          = chart.disciplines_pie(:female)
        .col-md-4
          %h3.h6 Disziplinen bei Männern
          = chart.disciplines_pie(:male)

    = content_card('Neue Person hinzufügen', toc:) do
      %p Ist eine Person, die du kennst, noch nicht eingetragen? Dann trag sie schnell ein!
      = link_to 'Person hinzufügen', new_contributions_person_path, id: 'add-person', class: 'btn btn-outline-secondary',
                                                                   data: { turbo_frame: 'contribution', turbo: true }
