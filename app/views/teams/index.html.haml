= table_of_contents do |toc|
  - chart = Chart::TeamOverview.new
  = page_head(page_title, toc:, tiles: [[Team.count, 'Mannschaften']])

  .container
    = content_card('Alle Mannschaften', toc:, label: 'Mannschaften') do
      = datatable(:teams)

    = content_card('Auswertung', toc:) do
      .row
        .col-md-4
          %h3.h6 Verteilung der Bundesländer
          = chart.federal_states_pie
        .col-md-4
          %h3.h6 Verteilung der Staaten
          = chart.international_states_pie
        .col-md-4
          %h3.h6 Aktive Mannschaften pro Jahr
          = chart.activities_for_years

    = content_card('Karte der Mannschaften', toc:, label: 'Karte') do
      = map(id: 'teams-map', markers: Team.positioned.decorate, class: 'big-map',
            data: { controller: 'overview-map', overview_map_circle_value: 20,
                    overview_map_bounds_value: [[50.4, 5.9], [54.5, 16.8]].to_json }) { |m| { count: m.competitions_count } }

    = content_card('Neue Mannschaft anlegen', toc:) do
      .row.g-4
        .col-md-7
          %p
            Ist deine Mannschaft oder Feuerwehr noch nicht eingetragen? Dann leg sie einfach an – mit ein paar Klicks
            und ohne Anmeldung ist das in einer Minute geschafft.
          = link_to 'Anlegen', new_contributions_team_path, id: 'add-team', class: 'btn btn-outline-secondary',
                                                            data: { turbo_frame: 'contribution', turbo: true }
        .col-md-5
          %h3.h6 Schreibweise für Freiwillige Feuerwehren
          %table.table.table-sm.w-auto
            %tr
              %th Name
              %td FF XXX
            %tr
              %th Abkürzung
              %td XXX
