= table_of_contents do |toc|
  - chart = Chart::TeamShow.new(team: resource)
  - logo = capture do
    - if resource.image.present?
      = image_tag(resource.image.tile.url, alt: "Logo #{resource.name}")
    - else
      = link_to new_contributions_team_change_request_path(resource, kind: 'logo'), class: 'upload-logo',
                title: 'Logo hochladen', data: { turbo_frame: 'contribution', turbo: true } do
        = design_image(:upload_logo)
  - state = capture do
    = resource.full_state.presence || 'Bundesland unbekannt'
    = link_to edit_contributions_team_state_path(resource), id: 'edit-state', title: 'Bundesland bearbeiten',
              'aria-label': 'Bundesland bearbeiten', class: 'btn btn-sm', data: { turbo_frame: 'contribution', turbo: true } do
      %span.fa.fa-pen{ 'aria-hidden': 'true' }
  = page_head(resource.name, breadcrumb: [link_to('Mannschaften', teams_path), resource.name], image: logo,
              chips: [state, resource.human_status], toc:,
              tiles: [[@team_members.count, 'Wettkämpfer'], [@team_competitions.count, 'Wettkämpfe']]) do
    = render('links', links: resource.links, linkable_type: 'Team', linkable_id: resource.id)

  .container
    = render 'team_members', toc:, chart:
    = render 'team_competitions', toc:
    = render 'group_assessments', toc:
    = render 'group_disciplines', toc:, chart:
    = render 'group_series', toc:

    = content_card('Karte', toc:, data: { controller: 'geo-position',
                                          geo_position_url_value: edit_contributions_team_geo_position_path(resource),
                                          action: 'geo-position:edit@window->geo-position#edit' }) do
      .row.g-3
        .col-md-9
          = map(id: 'team-map', red: resource, data: { team_id: resource.id, geo_position_target: 'map' })
        .col-md-3.team-map-actions
          - unless resource.positioned?
            %p Für diese Mannschaft ist noch keine Geoposition hinterlegt.
            %button#add-geo-position.btn.btn-outline-secondary{ type: 'button', data: { action: 'geo-position#edit', geo_position_target: 'start' } }
              Geoposition hinzufügen
          %div{ hidden: true, data: { geo_position_target: 'save' } }
            %p Verschiebe den roten Marker an die richtige Stelle.
            %button.btn.btn-primary{ type: 'button', data: { action: 'geo-position#save' } } Speichern

    = render 'ui/report_error', toc:, label: 'Fehler mit dieser Mannschaft melden',
                                url: new_contributions_team_change_request_path(resource)
