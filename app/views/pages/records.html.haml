= table_of_contents do |toc|
  = page_head(@page_title, toc:)

  .container
    - @records.groups.each do |group|
      = content_card(group.title, toc:, heading: :h2) do
        .table-responsive
          %table.table.records-table
            %thead
              %tr
                %th Disziplin
                %th Name
                %th= group.scope == :german ? 'Mannschaft' : 'Nation'
                %th Zeit
                %th Aufgestellt
            %tbody
              - group.records.each do |record|
                %tr
                  %td
                    .d-flex.align-items-center.gap-2
                      = discipline_image(record.discipline)
                      %span
                        = discipline_name(record.discipline)
                        - if record.note.present?
                          %br
                          %small.times= record.note
                  - if record.german?
                    %td
                      - if record.people.one?
                        = person_link(record.people.first, type: :full_name)
                      - else
                        %small= safe_join(record.people.map { |person| person_link(person, type: :short_name) }, ', ')
                    %td
                      - if record.team
                        = record.team.image_thumb
                        = team_link(record.team)
                  - else
                    %td= safe_join(record.holders.filter_map(&:name), tag.br)
                    %td.text-nowrap
                      = safe_join(record.holders.map(&:nation).compact.uniq.map { |n| safe_join([n.nation_flag, n.name], ' ') }, tag.br)
                  %td.text-nowrap
                    %strong #{record.time} s
                    - if record.split.present?
                      %br
                      %small.times= record.split
                  %td= record.competition ? competition_link(record.competition) : record.event
    %p.text-muted Stand: #{l(@records.updated_on)}
