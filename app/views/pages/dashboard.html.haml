= table_of_contents do |toc|
  - charts = Chart::Dashboard.new
  - tiles = [[Competition.count, 'Wettkämpfe'], [Score.valid.count + GroupScore.valid.count, 'Zeiten'],
    [Person.count, 'Wettkämpfer'], [Team.count, 'Mannschaften'], [Place.count, 'Wettkampforte']]

  = page_head('Feuerwehrsport – die große Auswertung', kicker: "Ergebnisse seit #{@years_count.last&.first}",
              tiles:, toc:) do
    %p.lead.mb-0
      Hakenleitersteigen, 100-Meter-Hindernisbahn, Gruppenstafette, 4×100-Meter-Feuerwehrstafette und Löschangriff nass:
      Zeiten, Bestenlisten und Statistiken aus Wettkämpfen in ganz Deutschland.

  .container
    = content_card('Disziplinen', toc:, action: link_to('Die 100 schnellsten Zeiten →', best_of_path)) do
      %p.text-muted Die schnellsten Zeiten, die bisher in der Datenbank stehen.
      .discipline-cards
        - Calc::DisciplineBests.new.disciplines.each do |entry|
          .discipline-card
            .discipline-card-head
              %span.disc-chip= discipline_name_short(entry[:discipline])
              %span.name= discipline_name(entry[:discipline])
            %dl.discipline-bests
              - entry[:bests].each do |gender, score|
                %dt{ class: "gender-#{gender}", title: g(gender) }= g_symbol(gender)
                %dd
                  = link_to("#{score.second_time} s", competition_path(score.object.competition), class: 'time',
                            title: score.competition.to_s)
                  %span.holder
                    - if score.object.is_a?(Score)
                      = person_link(score.person, type: :full_name)
                    - else
                      = team_link(score.team)

    .row
      .col-lg-8
        = content_card('Neu eingetragene Wettkämpfe', toc:, label: 'Neue Wettkämpfe',
                       action: link_to('Alle anzeigen →', last_competitions_path)) do
          .table-responsive
            %table.table.table-hover.mb-0
              %thead
                %tr
                  %th Datum
                  %th Ort
                  %th.d-none.d-md-table-cell Typ
                  %th Name
              %tbody
                - @last_competitions.each do |competition|
                  %tr
                    %td.text-nowrap= competition.object.date.strftime('%d.%m.%Y')
                    %td= place_link(competition.place)
                    %td.d-none.d-md-table-cell= event_link(competition.event)
                    %td= competition_link(competition, type: :name).presence || competition_link(competition, type: :to_s)
      .col-lg-4
        %section.content-card.content-card-dark
          = toc.anker('feusport.de', :h2)
          %p
            Termine, Online-Anmeldungen und Live-Ergebnisse findest du auf feusport.de.
            Die Ergebnisse landen danach hier in der Statistik.
          = link_to('Zu feusport.de', 'https://feusport.de', class: 'btn btn-light')
        = content_card('Mitmachen', toc:) do
          %p
            Du hast Ergebnisse, die hier noch fehlen, oder einen Fehler entdeckt? Hilf mit, die Daten vollständig zu
            machen.
          .d-flex.flex-wrap.gap-2
            = link_to('Ergebnisse hochladen', decide_login_backend_import_requests_path, class: 'btn btn-primary')
            = link_to('Fehler melden', impressum_path, class: 'btn btn-outline-secondary')

    = content_card("Super Leistungen vom Jahr #{@best_of_year}", toc:, label: "Leistungen #{@best_of_year}") do
      - performance_overview_disciplines = Calc::PerformanceOfYear.get(@best_of_year)
      = nav_tab do |nv|
        - performance_overview_disciplines.each do |discipline|
          - nv.tab(discipline_image_name_short(discipline.key, discipline.gender)) do
            %table.table
              - discipline.entries.first(5).each do |entry|
                %tr
                  %td.col-w-5= entry.rank
                  %td.col-w-25= person_link(entry.entity.decorate, type: :full_name)
                  %td.col-w-70= score_links(entry.scores)
                %tr.hint-line
                  %td{ colspan: 2 }
                    %em= "#{entry.rounded_points} Punkte"
                  %td
                    Durchschnitt:
                    %strong= entry.second_valid_time_average

    .row
      .col-lg-8
        = content_card('Jahre', toc:) do
          %p
            Für #{link_to('jedes Jahr', years_path)} gibt es eigene Statistiken. In Klammern steht die Anzahl der
            Wettkämpfe.
          .years-overview-home
            - @years_count.each do |year, count|
              = link_to(year_path(year), title: "Überblick über das Jahr #{year}") do
                %strong= year
                %span= count
      .col-lg-4
        = content_card('Ø Beste 5 pro Wettkampf', heading: :h3) do
          = charts.year_overview

    .row
      .col-lg-6
        = content_card('Über die Daten', toc:) do
          %p
            Die Datenbank besteht aus vielen Tabellen, die mit verschiedenen Algorithmen verbunden und ausgewertet
            werden. Unterschieden wird zwischen #{link_to('Wettkampftypen', events_path)} (D-Cup, DM, WM) und
            #{link_to('Wettkämpfen', competitions_path)} (DM 2012 in Cottbus oder D-Cup 2012 in Tüttleben). Dazu werden
            die #{link_to('Wettkampforte', places_path)} gespeichert, damit auch Zeiten auf Tartanbahn mit denen auf
            Schotterbahnen verglichen werden können.
          %p
            Personen werden über ihren Namen erkannt. Gibt es zwei Personen mit gleichem Namen,
            #{link_to('melde dich', impressum_path)} bitte.
          %p
            Die Daten stammen aus verschiedenen Quellen. Können die Quellen verlinkt werden oder liegen sie als PDF vor,
            findest du sie auf der Seite des Wettkampfes. Ein großer Dank geht an
            #{link_to('Florian Müller', person_path(302))}, der sehr viele Daten eingepflegt hat.
          %p
            Der Quelltext der Website ist
            #{link_to('auf GitHub', 'https://github.com/Feuerwehrsport/feuerwehrsport-statistik-website')} einsehbar.
            Die komplette Datenbank schicke ich dir auf #{link_to('E-Mail-Anfrage', impressum_path)} zu.
          %p
            Falls du der Meinung bist, dass hier deine Rechte verletzt werden, schreib mir bitte zuerst eine
            #{link_to('E-Mail', impressum_path)}. Ich kümmere mich schnell darum.
          %p.mb-0
            Die Feuerwehrsport-Statistik ist kostenlos und werbefrei – und das bleibt auch so. Wer sich trotzdem
            bedanken möchte, findet bei feusport.de #{link_to('ein paar Möglichkeiten', 'https://feusport.de/donations')}.
      .col-lg-6
        = content_card('Fehler in den Daten', toc:) do
          %p
            Die Daten stammen aus unterschiedlichen Quellen, die alle einzeln importiert wurden. Dabei kommt es immer
            wieder zu Fehlern, weil Namen falsch zugeordnet oder Zeiten verschoben sind. Hast du so einen Fehler
            gefunden, schick mir eine #{link_to('E-Mail', impressum_path)} oder melde ihn über die Funktionen auf der
            jeweiligen Seite.
          %p
            Viele Namen wurden in den Ergebnislisten falsch geschrieben und sind deshalb doppelt in der Datenbank.
            Auf der Seite der falsch geschriebenen Person kannst du das über „Fehler mit dieser Person melden“
            korrigieren lassen.
          %p.mb-0
            Noch interessanter sind zusätzliche Daten. Hast du eine Ergebnisliste, die hier fehlt, dann
            #{link_to('lade sie hoch', decide_login_backend_import_requests_path)}. Am besten eignen sich digitale
            Listen; eingescannte Listen lassen sich nicht importieren. Bitte gib dazu einen Link als Nachweis an.
