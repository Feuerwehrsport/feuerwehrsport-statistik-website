!!!
%html
  = render 'layouts/head'
  %body
    = render 'navigation'
    %main.site-main
      - unless save_html_cache?
        = render 'flash_messages'
      = yield
    = render 'footer'
    -# dialog for contributions of visitors (Hotwire, see Contributions::BaseController)
    %dialog.contribution-dialog{ tabindex: -1, data: { controller: 'contribution-dialog',
                                         action: 'turbo:frame-load->contribution-dialog#open close->contribution-dialog#reset' } }
      = turbo_frame_tag 'contribution', data: { turbo: true, contribution_dialog_target: 'frame' }
