%table.datatable.datatable-serverside.table.table-hover.table-sm{ data: { controller: 'datatable-serverside', datatable_options: data.to_json } }
  %thead
    %tr
      - structure.each do |field|
        - label = field.options[:label] || ca_t(field.name, scope: :index_table_headers, default: structure.klass.human_attribute_name(field.name)).html_safe
        %th{ class: field.options[:th_class] }= label
  %tbody