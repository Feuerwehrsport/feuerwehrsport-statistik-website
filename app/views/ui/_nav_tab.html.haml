%div
  %ul.nav.nav-tabs{ role: 'tablist' }
    - nt.tabs.each_with_index do |tab, index|
      %li.nav-item{ role: 'presentation' }
        %button.nav-link{ class: index.zero? ? 'active' : nil, type: 'button', role: 'tab',
                          data: { bs_toggle: 'tab', bs_target: "##{tab.global_id}" } }= tab.name
  .tab-content
    - nt.tabs.each_with_index do |tab, index|
      .tab-pane.fade{ class: index.zero? ? 'show active' : nil, id: tab.global_id, role: 'tabpanel' }
        = capture_haml &tab.block
